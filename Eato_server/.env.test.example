# Isolated e2e test configuration. Copy to .env.test (ignored by Git) and fill in.
# The suite refuses to run unless DB_NAME and DB_USER are exactly eato_test.
PORT=4100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=eato_test
DB_PASSWORD=
DB_NAME=eato_test
# Clerk DEVELOPMENT instance secret key (same instance as the app's .env). Test users are
# created and deleted on this instance with the +clerk_test email convention.
CLERK_SECRET_KEY=
