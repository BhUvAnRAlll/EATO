# Isolated e2e test configuration. Copy to .env.test (ignored by Git) and fill in.
# The suite refuses to run unless DB_NAME and DB_USER are exactly eato_test.
PORT=4100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=eato_test
DB_PASSWORD=
DB_NAME=eato_test
# Test accounts and sessions are written straight into eato_test (no external service), and
# codes go to a fake SMS outbox in a temporary folder. The harness makes a throwaway
# AUTH_SECRET for each run; set one here only to pin it.
# AUTH_SECRET=
