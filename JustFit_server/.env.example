# Copy to .env and fill in. Never commit .env.
PORT=4000

# MySQL (schema.sql creates the "justfit" database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=justfit_app
DB_PASSWORD=
DB_NAME=justfit

# Phone sign-in (auth/). AUTH_SECRET: at least 32 random characters, generated on this
# machine and kept only here. It keys the sign-in code hashes and the member passes; it is
# not the SMS provider's key. Changing it invalidates codes and passes in flight (not
# sessions). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# How sign-in codes are sent: off (default: phone sign-in answers 503), or fast2sms. ("fake"
# exists for the test suite only and is refused outside justfit_test.)
SMS_PROVIDER=off
# Fast2SMS (server-side only, never in the app or an EXPO_PUBLIC_ variable)
# FAST2SMS_API_KEY=
# FAST2SMS_ROUTE=dlt               # dlt (DLT sender id + template) or otp (OTP API template)
# FAST2SMS_SENDER_ID=              # dlt: the 3-6 letter approved sender id
# FAST2SMS_TEMPLATE_ID=            # dlt: the approved template's message id
# FAST2SMS_OTP_ID=                 # otp: the OTP template id

# Optional sign-in limits (defaults: 60 s between codes, 5 an hour and 10 a day per number,
# 500 codes a day in all, per IP 10 requests and 30 verifies per 10 minutes). Codes always
# last 5 minutes and lock after 5 wrong tries.
# OTP_COOLDOWN_SECONDS=
# OTP_PER_HOUR=
# OTP_PER_DAY=
# OTP_DAILY_SMS_CAP=
# OTP_IP_REQUEST_LIMIT=
# OTP_IP_VERIFY_LIMIT=
# OTP_IP_WINDOW_SECONDS=

# Behind a reverse proxy only: which hops to trust for the client's IP ("1", or addresses such
# as "loopback"). Leave unset when the app talks to this server directly.
# TRUST_PROXY=

# OpenAI: reads uploaded body composition reports (bodyComposition/extract.js). Server-side
# only. OPENAI_MODEL is optional (defaults to gpt-4o).
OPENAI_API_KEY=
# OPENAI_MODEL=
# Which model each AI feature uses (ai/models.js). Defaults: gpt-4.1-mini for the coach's chat,
# plans and meal swaps, Scan Food and report reading; gpt-4o-mini for the gym assistant. Set one to
# change only that feature (a model named here needs a row in ai_model_prices to be costed).
# AI_MODEL_COACH_CHAT=
# AI_MODEL_COACH_PLAN=
# AI_MODEL_COACH_MEAL=
# AI_MODEL_FOOD_SCAN=
# AI_MODEL_BODY_REPORT=
# AI_MODEL_GYM_ASSISTANT=
# AI_MAX_OUTPUT_COACH_CHAT=          # the answer cap in tokens, per feature (same names as above)
# AI_REASONING_EFFORT=minimal        # only for a gpt-5 / o-series model
# AI usage limits (ai/limits.js). 0 switches a limit off.
# AI_LIMIT_PER_MINUTE=12             # AI calls a member may make in a minute, all features together
# AI_LIMIT_PER_DAY=150               # AI calls a member may make in a day
# AI_PLAN_LIMIT_PER_DAY=3            # plans (meals + workout) a member may make in a day
# AI_BUDGET_HARD_STOP=on             # off: keep answering after the monthly budget (ai_budget) is spent
# AI_CACHE=on                        # off: never reuse a gym assistant answer
# AI_CACHE_TTL_MINUTES=1440          # how long a reusable answer is kept

# Forma photo scan server (bodyComposition/scan.js): estimates body fat % from a front and a
# side photo. A separate process (Forma_BodyFat/forma_server.py or its Docker image). Keep it
# reachable only from this server (localhost or a private network). Unset: the scan route
# answers 503. Photos pass through in memory and are never stored or logged.
FORMA_SCAN_URL=http://127.0.0.1:8765

# Where community images (posts, stories, group covers) are written. Optional; defaults to
# JustFit_server/uploads/. Files are served only to signed-in members through /api/media/:id.
# UPLOAD_DIR=

# WhatsApp gym agent (whatsapp/). Platform settings, server-side only. Each gym's own number id
# and access token are stored per gym in whatsapp_connections, the token encrypted.
# META_APP_ID=
# META_APP_SECRET=                 # checks Meta's signature on every webhook; without it the webhook answers 503
# META_WEBHOOK_VERIFY_TOKEN=       # any random string; paste the same one into Meta's webhook setup
# META_GRAPH_VERSION=              # e.g. v23.0 (use the version Meta's docs show)
# META_EMBEDDED_SIGNUP_CONFIG_ID=  # for owners connecting their own number (later phase)
# WHATSAPP_TOKEN_KEY=              # 32 random bytes as hex: openssl rand -hex 32
# WHATSAPP_WORKER=off              # optional: keep the job worker off on this server
# AI_MODEL=                        # the model the agent replies with (later phase)
#
# Development only: connect one gym to Meta's test number with
#   node scripts/connect-whatsapp-number.js --gym "<gym name or id>"
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# Browser origins allowed to call the API (httpSecurity.js), comma-separated, for an admin site
# or the Expo web build served from a fixed address. Unset: none in production (the native app
# sends no Origin header and is unaffected), any in development and tests (Expo web on a local port).
# CORS_ORIGINS=https://admin.example.com
