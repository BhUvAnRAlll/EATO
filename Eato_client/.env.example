# Copy to .env and fill in. Never commit .env.

# Clerk (Dashboard → API keys). The publishable key ships in the app; the secret key is
# read only by the Expo API routes (src/app/api/) and scripts/set-role.mjs.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenAI: reads uploaded body composition reports (src/server/bodyComposition/extract.ts).
# Server-side only. OPENAI_MODEL is optional (defaults to gpt-4o).
OPENAI_API_KEY=
# OPENAI_MODEL=

# EATO Express server. Leave unset in development: the app uses the computer running
# `expo start` on port 4000. Set to the deployed HTTPS URL for production builds.
# EXPO_PUBLIC_API_URL=

# Deployed Expo Router API server origin. Required for production builds (see app.config.ts).
# EXPO_PUBLIC_API_ORIGIN=
