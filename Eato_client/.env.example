# Copy to .env and fill in. Never commit .env.

# Clerk (Dashboard → API keys). The publishable key ships in the app. The secret key is
# read only by scripts/set-role.mjs (`npm run set-role`); the app itself never uses it.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# JustFit Express server (Eato_server/). Leave unset in development: the app uses the computer
# running `expo start` on port 4000. Set to the deployed HTTPS URL for production builds.
# EXPO_PUBLIC_API_URL=
