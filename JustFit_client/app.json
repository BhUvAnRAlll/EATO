{
  "expo": {
    "name": "justFit",
    "slug": "justfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "justfit",
      "eato"
    ],
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.bhuvii3.justfit",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "android": {
            "image": "./assets/images/splash-icon-android.png"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "justFit uses the camera to take photos for body scans and food logging.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "justFit uses your photo library so you can choose photos for body scans and food logging.",
          "cameraPermission": "justFit uses the camera to take photos for body scans and food logging.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.bhuvii3.justfit",
      "appleTeamId": "5KZK728YHB",
      "icon": "./assets/images/icon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "backgroundColor": "#F4F4F5"
  }
}
