# Copy to .env and fill in. Never commit .env.

# Nothing secret belongs here: every EXPO_PUBLIC_ value ships inside the app. Sign-in (phone
# and code) and every key for it live on the server (JustFit_server/.env).

# justFit Express server (JustFit_server/). Leave unset in development: the app uses the computer
# running `expo start` on port 4000. Set to the deployed HTTPS URL for production builds.
# EXPO_PUBLIC_API_URL=
